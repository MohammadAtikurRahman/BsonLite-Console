{
  "name": "bsonlite-cli",
  "version": "0.3.0",
  "description": "BsonLite desktop database browser and terminal console with connection URLs",
  "author": "Md. Atikur Rahman",
  "license": "MIT",
  "homepage": "https://bsonlite.com/console.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammadAtikurRahman/BsonLite-Console.git"
  },
  "bugs": {
    "url": "https://github.com/MohammadAtikurRahman/BsonLite-Console/issues"
  },
  "main": "desktop/main.cjs",
  "exports": {
    "./bridge": "./src/bridge.cjs"
  },
  "bin": {
    "bsonlite": "bin/bsonlite.cjs"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node bin/bsonlite.cjs",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer.ps1",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --dir",
    "build:sdk": "node scripts/build-sdk.cjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "mongodb": "6.16.0"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.5",
    "playwright": "1.62.1"
  },
  "files": [
    "bin/",
    "src/",
    "desktop/",
    "examples/",
    "README.md",
    "START_HERE.md",
    "LICENSE"
  ],
  "build": {
    "appId": "com.bsonlite.console",
    "productName": "BsonLite Console",
    "executableName": "BsonLite Console",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "desktop/ui/icon.ico",
      "artifactName": "BsonLite-Console-Setup-${version}-Windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BsonLite Console",
      "uninstallDisplayName": "BsonLite Console",
      "installerIcon": "desktop/ui/icon.ico",
      "uninstallerIcon": "desktop/ui/icon.ico",
      "installerHeaderIcon": "desktop/ui/icon.ico",
      "runAfterFinish": true,
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false
    }
  }
}
